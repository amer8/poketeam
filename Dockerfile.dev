# Local container image for exercising the static export with GitHub Pages-like
# fallback behavior. Production deployment happens via GitHub Pages.
FROM node:24-alpine AS build
WORKDIR /app
COPY . .
RUN yarn install --frozen-lockfile
RUN yarn build

FROM nginx:stable-alpine
COPY --from=build /app/out /usr/share/nginx/html
COPY --from=build /app/nginx.dev.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
